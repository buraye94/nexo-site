---
import { t } from '../i18n/utils';
import { servicePages, cityPages, hubPage, homePath, blogPath, type Lang } from '../data/pages';

interface Props {
  lang?: Lang;
  alternateUrl?: string;
  contactHref?: string;
}

const { lang = 'es', alternateUrl, contactHref = '/#contacto' } = Astro.props;
const current = Astro.url.pathname;
const other: Lang = lang === 'es' ? 'en' : 'es';
const langHref = alternateUrl ?? homePath(other);
const services = servicePages();
const cities = cityPages();
const hub = hubPage();
const results = `${homePath(lang)}#resultados`;
const ariaCurrent = (path: string) => (current === path ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap">
    <nav class="site-nav" aria-label={t(lang, 'nav.label')}>
      <a class="logo" href={homePath(lang)}>
        <img src="/logo.svg" alt="" width="24" height="24" />
        clicroot
      </a>

      <ul class="nav-links">
        <li data-menu>
          <button class="nav-link" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-services">
            {t(lang, 'nav.services')} <span class="caret" aria-hidden="true">▾</span>
          </button>
          <ul class="nav-panel" id="menu-services" hidden>
            {services.map((p) => <li><a href={p[lang].path} aria-current={ariaCurrent(p[lang].path)}>{p[lang].label}</a></li>)}
            <li><a class="nav-panel__all" href={hub[lang].path} aria-current={ariaCurrent(hub[lang].path)}>{hub[lang].label}</a></li>
          </ul>
        </li>
        <li data-menu>
          <button class="nav-link" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-cities">
            {t(lang, 'nav.cities')} <span class="caret" aria-hidden="true">▾</span>
          </button>
          <ul class="nav-panel" id="menu-cities" hidden>
            {cities.map((p) => <li><a href={p[lang].path} aria-current={ariaCurrent(p[lang].path)}>{p[lang].label}</a></li>)}
          </ul>
        </li>
        <li><a class="nav-link" href={results}>{t(lang, 'nav.results')}</a></li>
        <li><a class="nav-link" href={blogPath(lang)} aria-current={current.startsWith(blogPath(lang)) ? 'page' : undefined}>{t(lang, 'nav.blog')}</a></li>
      </ul>

      <div class="nav-right">
        <a class="lang-switch" href={langHref} hreflang={other} aria-label={t(lang, 'nav.langSwitchLabel')}>{t(lang, 'nav.langSwitch')}</a>
        <a class="btn btn--primary btn--sm" href={contactHref}>{t(lang, 'nav.cta')}</a>
        <button class="menu-btn" type="button" data-sheet-open aria-expanded="false" aria-controls="nav-sheet">{t(lang, 'nav.menu')}</button>
      </div>
    </nav>
  </div>

  <div class="sheet" id="nav-sheet" hidden role="dialog" aria-modal="true" aria-label={t(lang, 'nav.menu')}>
    <div class="sheet__top">
      <a class="logo" href={homePath(lang)}><img src="/logo.svg" alt="" width="24" height="24" />clicroot</a>
      <button class="sheet__close" type="button" data-sheet-close aria-label={t(lang, 'nav.close')}>×</button>
    </div>
    <div class="sheet__group">
      <h2>{t(lang, 'nav.services')}</h2>
      {services.map((p) => <a href={p[lang].path}>{p[lang].label}</a>)}
      <a href={hub[lang].path}>{hub[lang].label}</a>
    </div>
    <div class="sheet__group">
      <h2>{t(lang, 'nav.cities')}</h2>
      {cities.map((p) => <a href={p[lang].path}>{p[lang].label}</a>)}
    </div>
    <div class="sheet__group">
      <a href={results}>{t(lang, 'nav.results')}</a>
      <a href={blogPath(lang)}>{t(lang, 'nav.blog')}</a>
      <a href={langHref} hreflang={other}>{t(lang, 'nav.langSwitchLabel')}</a>
    </div>
    <a class="btn btn--primary" href={contactHref}>{t(lang, 'nav.cta')}</a>
  </div>
</header>
