---
import { t } from '../i18n/utils';
import { servicePages, cityPages, hubPage, homePath, blogPath, type Lang } from '../data/pages';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const services = [...servicePages(), hubPage()];
const cities = cityPages();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <a class="logo" href={homePath(lang)}><img src="/logo.svg" alt="" width="24" height="24" />clicroot</a>
        <p style="margin-top:12px;max-width:34ch">{t(lang, 'footer.desc')}</p>
      </div>
      <div>
        <h2>{t(lang, 'footer.services')}</h2>
        <ul>{services.map((p) => <li><a href={p[lang].path}>{p[lang].label}</a></li>)}</ul>
      </div>
      <div>
        <h2>{t(lang, 'footer.cities')}</h2>
        <ul>{cities.map((p) => <li><a href={p[lang].path}>{p[lang].label}</a></li>)}</ul>
      </div>
      <div>
        <h2>{t(lang, 'footer.company')}</h2>
        <ul>
          <li><a href={blogPath(lang)}>{t(lang, 'footer.blog')}</a></li>
          <li><a href={`${homePath(lang)}#contacto`}>{t(lang, 'footer.contact')}</a></li>
          <li><a href="mailto:hello@clicroot.com">hello@clicroot.com</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>{t(lang, 'footer.copy')}</span>
      <span>Clicroot · hello@clicroot.com</span>
    </div>
  </div>
</footer>
