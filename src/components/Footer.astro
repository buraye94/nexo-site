---
interface Props {
  t: (key: string) => any;
  anchorBase?: string;
  lang?: string;
}
const { t, anchorBase = '', lang = 'es' } = Astro.props;
const serviceLinks = lang === 'en'
  ? [
      { href: '/en/seo-consulting', label: 'SEO Consulting' },
      { href: '/en/seo-services', label: 'SEO Services' },
      { href: '/en/seo-audit', label: 'SEO Audit' },
      { href: '/en/geo-generative-engine-optimization', label: 'GEO: AI visibility' },
    ]
  : [
      { href: '/consultoria-seo', label: 'Consultoría SEO' },
      { href: '/servicios-seo', label: 'Servicios SEO' },
      { href: '/auditoria-seo', label: 'Auditoría SEO' },
      { href: '/geo-posicionamiento-en-ia', label: 'GEO: visibilidad en IA' },
    ];
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div>
        <div class="footer-logo">
          <span class="footer-logo-mark"><img src="/logo.svg" alt="clicroot" width="22" height="22" /></span>
          clicroot
        </div>
        <p class="footer-desc">{t('footer.desc')}</p>
      </div>
      <div class="footer-col">
        <h4>{t('footer.navTitle')}</h4>
        <a href={`${anchorBase}#services`}>{t('nav.services')}</a>
        <a href={`${anchorBase}#cases`}>{t('nav.cases')}</a>
        <a href={`${anchorBase}#blog`}>{t('nav.blog')}</a>
        <a href={`${anchorBase}#contact`}>{t('nav.contact')}</a>
      </div>
      <div class="footer-col">
        <h4>{t('footer.svcTitle')}</h4>
        {serviceLinks.map((s) => <a href={s.href}>{s.label}</a>)}
      </div>
      <div class="footer-col">
        <h4>{t('footer.connectTitle')}</h4>
        <a href="mailto:hello@clicroot.com">hello@clicroot.com</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">{t('footer.copy')}</span>
      <span class="footer-status">
        <span class="status-dot"></span>
        {t('footer.status')}
      </span>
    </div>
  </div>
</footer>
