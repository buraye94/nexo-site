---
// Reading template for posts (design D25): 70ch measure, closing block that hands
// off to the related service page and the first-call form. Shared by ES and EN.
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { t } from '../i18n/utils';
import { getPage, blogPath, homePath, type Lang } from '../data/pages';
import { esToEn, enToEs } from '../i18n/blog-slugs';
import { relatedPageId, readingMinutes, formatDate } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { Content } = await post.render();
const b = (key: string) => t(lang, `blog.${key}`);
const site = 'https://clicroot.com';
const slug = post.slug.replace(`${lang}/`, '');
const url = `${site}${blogPath(lang)}${slug}/`;

// hreflang only when the twin post really exists (eng review R4).
const other: Lang = lang === 'es' ? 'en' : 'es';
const twinSlug = lang === 'es' ? esToEn[slug] : enToEs[slug];
const twins = await getCollection('blog', (p) => p.data.lang === other && !p.data.draft);
const twinExists = Boolean(twinSlug && twins.some((p) => p.slug.replace(`${other}/`, '') === twinSlug));
const alternateUrl = twinExists ? `${blogPath(other)}${twinSlug}/` : undefined;

const service = getPage(relatedPageId(post.data.tags));
const minutes = readingMinutes(post.body);

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: `${site}${homePath(lang)}` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}${blogPath(lang)}` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
  {
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString().split('T')[0],
    inLanguage: lang,
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'Clicroot' },
    publisher: { '@id': `${site}/#org` },
  },
];
---

<Layout title={`${post.data.title} | clicroot`} description={post.data.description} lang={lang} alternateUrl={alternateUrl} schema={schema}>
  <article class="paper post">
    <div class="wrap">
      <header class="post__head">
        <a class="post__back" href={blogPath(lang)}>{b('back')}</a>
        <p class="mono" style="color:var(--olive-text)"><time datetime={post.data.date.toISOString().split('T')[0]}>{formatDate(post.data.date, lang)}</time> · {minutes} {b('minRead')}</p>
        <h1>{post.data.title}</h1>
        <p class="lead" style="color:var(--body-paper)">{post.data.description}</p>
      </header>
      <div class="post-body">
        <Content />
      </div>
      <aside class="post-close" aria-labelledby="post-close-title">
        <h2 id="post-close-title">{b('closeTitle')}</h2>
        <p>{b('closeText')}</p>
        <div class="ctas">
          <a class="btn btn--primary" href={`${homePath(lang)}#contacto`}>{b('closeCta')}</a>
          <a class="btn btn--ghost" href={service[lang].path}>{`${b('closeService')} ${service[lang].label} →`}</a>
        </div>
      </aside>
    </div>
  </article>
</Layout>
