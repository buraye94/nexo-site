---
import { t } from '../i18n/utils';
import { homePath, type Lang } from '../data/pages';

interface Props {
  lang: Lang;
  hasForm: boolean;
}

const { lang, hasForm } = Astro.props;
// Without JS the link reloads with ?motivo=..., which ContactForm reads on load.
const href = hasForm ? '?motivo=diagnostico-ia#contacto' : `${homePath(lang)}?motivo=diagnostico-ia#contacto`;
---

<aside class="offer" aria-label={t(lang, 'offer.long')}>
  <div class="offer__inner">
    <a class="offer__link" href={href} data-offer-link data-same-page={hasForm ? 'true' : 'false'}>
      <span class="offer__long">{t(lang, 'offer.long')}<strong>{t(lang, 'offer.cta')}</strong></span>
      <span class="offer__short">{t(lang, 'offer.short')}</span>
    </a>
    <button class="offer__close" type="button" data-offer-close aria-label={t(lang, 'offer.close')}>×</button>
  </div>
</aside>
