---
interface Props {
  title: string;
  description: string;
  lang: string;
  alternateUrl?: string;
  image?: string;
}

const { title, description, lang, alternateUrl, image } = Astro.props;
const alternateLang = lang === 'en' ? 'es' : 'en';

const site = Astro.site ?? new URL('https://clicroot.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image ?? '/og-default.png', site).href;
const altAbsolute = alternateUrl ? new URL(alternateUrl, site).href : undefined;
const xDefault = lang === 'es' ? canonical : (altAbsolute ?? canonical);
const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://clicroot.com/#org",
  "name": "Clicroot",
  "url": "https://clicroot.com/",
  "logo": new URL('/logo.svg', site).href,
  "image": ogImage,
  "description": description,
  "email": "hello@clicroot.com",
  "serviceType": ["SEO Consulting", "Generative Engine Optimization", "AI Visibility"],
  "areaServed": ["CO", "MX", "US", "ES"],
  "availableLanguage": ["Spanish", "English"]
};
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Canonical + hreflang -->
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang={lang} href={canonical} />
  {altAbsolute && <link rel="alternate" hreflang={alternateLang} href={altAbsolute} />}
  <link rel="alternate" hreflang="x-default" href={xDefault} />

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Clicroot">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta property="og:locale" content={ogLocale}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Fonts: Urbanist, Figtree, Cormorant Garamond, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Figtree:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Urbanist:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
</head>
<body>
  <slot />

  <script>
    // Theme
    const html = document.documentElement;
    const stored = localStorage.getItem('theme');
    if (stored) html.setAttribute('data-theme', stored);
    else if (window.matchMedia('(prefers-color-scheme: dark)').matches) html.setAttribute('data-theme', 'dark');

    document.getElementById('themeToggle')?.addEventListener('click', () => {
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });

    // Scroll reveal
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -20px 0px' });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

    // Counter animation
    const cobs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const c = e.target as HTMLElement;
          const target = parseInt(c.dataset.target || '0');
          const start = performance.now();
          function update(now: number) {
            const p = Math.min((now - start) / 2000, 1);
            c.textContent = Math.floor((1 - Math.pow(1 - p, 3)) * target).toString();
            if (p < 1) requestAnimationFrame(update);
            else c.textContent = target.toString();
          }
          requestAnimationFrame(update);
          cobs.unobserve(c);
        }
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('.counter').forEach(c => cobs.observe(c));

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        e.preventDefault();
        const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
        if (href) {
          const t = document.querySelector(href);
          if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Nav morph on scroll
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 40));

    // Mobile menu
    document.getElementById('hamburger')?.addEventListener('click', () => {
      document.getElementById('mobileMenu')?.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
    (window as any).closeMobile = () => {
      document.getElementById('mobileMenu')?.classList.remove('open');
      document.body.style.overflow = '';
    };
    document.getElementById('mobileClose')?.addEventListener('click', (window as any).closeMobile);

    // Telemetry typewriter
    const telEl = document.getElementById('telemetryText');
    if (telEl) {
      const msgs = JSON.parse(telEl.dataset.messages || '[]');
      let mi = 0, ci = 0, typing = true;
      function tick() {
        if (!msgs.length) return;
        if (typing) {
          telEl!.textContent = msgs[mi].slice(0, ci + 1);
          ci++;
          if (ci >= msgs[mi].length) { typing = false; setTimeout(tick, 2000); return; }
          setTimeout(tick, 45);
        } else {
          telEl!.textContent = msgs[mi].slice(0, ci - 1);
          ci--;
          if (ci <= 0) { mi = (mi + 1) % msgs.length; typing = true; setTimeout(tick, 400); return; }
          setTimeout(tick, 25);
        }
      }
      tick();
    }

    // Form
    document.getElementById('contactForm')?.addEventListener('submit', async e => {
      e.preventDefault();
      const btn = document.getElementById('formSubmit') as HTMLButtonElement;
      const form = e.target as HTMLFormElement;
      const data = Object.fromEntries(new FormData(form));
      btn.disabled = true;
      btn.textContent = '...';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          btn.textContent = '✓';
          btn.style.background = 'var(--accent)';
          btn.style.color = 'white';
          form.reset();
        } else {
          btn.textContent = 'Error';
          btn.style.background = '#c33';
          btn.style.color = 'white';
        }
      } catch(err) {
        btn.textContent = 'Error';
        btn.style.background = '#c33';
        btn.style.color = 'white';
      }
      setTimeout(() => { btn.textContent = btn.dataset.label || 'Send'; btn.style.background = ''; btn.style.color = ''; btn.disabled = false; }, 3000);
    });
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
