---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t as translate } from '../i18n/utils';

const lang = 'es';
const tf = (key: string) => translate(lang, key);

const services = [
  { icon: '#i-search', title: 'SEO técnico', desc: 'Rastreo, indexación, velocidad y arquitectura, al nivel que exige un comprador de perfil técnico que sabe leer un sitio bien hecho. La base que Google y los crawlers de IA necesitan para entender tu sitio.' },
  { icon: '#i-pen', title: 'Contenido y on-page', desc: 'Páginas que responden lo que de verdad busca tu cliente tapatío, redactadas para que los modelos de IA puedan citarte.' },
  { icon: '#i-link', title: 'Autoridad y link building', desc: 'Enlaces y menciones de calidad, valiosas en un ecosistema de software y startups como el de la ZMG, que construyen autoridad de dominio sin atajos que terminen en una penalización.' },
  { icon: '#i-globe', title: 'SEO local', desc: 'Aparece en Google Maps y en las búsquedas locales de la Zona Metropolitana de Guadalajara, donde decide tu cliente.' },
  { icon: '#i-trending', title: 'GEO: visibilidad en IA', desc: 'Optimizamos tu marca para que ChatGPT, Perplexity, Gemini y los AI Overviews te recomienden cuando un comprador del sector tech evalúa proveedores.' },
  { icon: '#i-bar-chart', title: 'Medición y reporte', desc: 'Posiciones, tráfico orgánico e ingresos atribuibles, con la claridad de datos que pide un mercado acostumbrado a producto y software. Reportamos lo que mueve el negocio, no métricas de vanidad.' },
];

const faqs = [
  { q: '¿Qué hace una agencia SEO en Guadalajara?', a: 'Una agencia SEO en Guadalajara trabaja para que tu negocio aparezca cuando la gente de la Zona Metropolitana busca en Google lo que tú ofreces. Eso abarca SEO local (Google Maps, búsquedas locales), SEO técnico y contenido. En Clicroot sumamos GEO: optimizamos también para que ChatGPT, Perplexity y los AI Overviews te citen.' },
  { q: '¿Atienden a empresas de Zapopan, Tlaquepaque o Tonalá?', a: 'Sí. Trabajamos para negocios de toda la Zona Metropolitana de Guadalajara, incluidos Zapopan, San Pedro Tlaquepaque, Tonalá y Tlajomulco. El SEO local se ajusta al área donde quieres captar clientes, no a un solo municipio.' },
  { q: '¿Sirve el SEO para una empresa de tecnología o software en Guadalajara?', a: 'Mucho. Guadalajara es uno de los polos de tecnología y software más fuertes del país, y en ese sector el comprador investiga en línea antes de decidir. Si una startup o un comprador busca una solución y no apareces, le apareces a la competencia. El SEO te pone en la búsqueda y el GEO te pone en la respuesta de IA que ese perfil técnico consulta a diario.' },
  { q: '¿Qué es GEO y por qué lo incluyen?', a: 'GEO (generative engine optimization) es optimizar tu marca para los buscadores de inteligencia artificial. Cuando alguien le pregunta a ChatGPT por un proveedor en Guadalajara, ve la respuesta de la IA, no un listado de Google. Para un producto o un SaaS, además, importa que esa respuesta describa bien lo que haces, no solo que te nombre. Trabajamos esa precisión junto con el SEO clásico.' },
  { q: '¿Cuánto cuesta el posicionamiento web en Guadalajara?', a: 'Depende del alcance y del tipo de proyecto: posicionar un SaaS por categoría y producto no se cotiza igual que un negocio local de servicios. Trabajamos por auditoría, acompañamiento mensual o proyecto completo, con el alcance acordado por adelantado y sin permanencias forzadas. Agenda una llamada y te damos un rango claro.' },
  { q: '¿En cuánto tiempo se ven resultados?', a: 'El SEO es acumulativo. Las correcciones técnicas y los quick wins pueden mover posiciones en semanas; construir autoridad y rankear términos competidos toma de tres a seis meses o más. En varias categorías locales de Guadalajara la competencia orgánica aún deja margen, y ese contexto suele favorecer a una estrategia enfocada. Te damos expectativas honestas desde la primera llamada.' },
];

const pageTitle = 'Agencia SEO en Guadalajara + GEO | Clicroot';
const pageDesc = 'Agencia SEO en Guadalajara con consultores senior. Posicionamiento web local y visibilidad en IA (GEO) para empresas de la Zona Metropolitana. Agenda una llamada.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': 'https://clicroot.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Agencia SEO en Guadalajara', 'item': 'https://clicroot.com/agencia-seo-guadalajara/' },
      ],
    },
    {
      '@type': 'Service',
      'serviceType': 'Agencia SEO',
      'name': 'Agencia SEO y GEO en Guadalajara',
      'provider': { '@id': 'https://clicroot.com/#org' },
      'areaServed': 'Guadalajara, México',
      'availableLanguage': ['Spanish', 'English'],
      'description': 'Agencia SEO en Guadalajara con consultores senior. Posicionamiento web local y visibilidad en buscadores de IA (GEO) para empresas de la Zona Metropolitana.',
    },
    {
      '@type': 'FAQPage',
      'mainEntity': faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDesc} lang={lang}>
  <Nav lang={lang} t={tf} anchorBase="/" />

  <header class="lp-hero">
    <div class="container">
      <nav class="lp-breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>Agencia SEO en Guadalajara</span>
      </nav>
      <div class="lp-eyebrow">Agencia SEO + GEO · Guadalajara</div>
      <h1 class="lp-title">Agencia SEO en Guadalajara</h1>
      <p class="lp-lead">Guadalajara concentra buena parte del software y las startups del país, y ahí el cliente investiga en línea antes de decidir. Te posicionamos en Google y en los buscadores de IA como ChatGPT, Perplexity y Gemini, con consultores senior que diseñan y ejecutan, y resultados medibles.</p>
      <div class="lp-actions">
        <a href="/#contact" class="btn-primary">Agenda una llamada</a>
        <a href="#que-es" class="btn-outline">Qué hacemos</a>
      </div>
    </div>
  </header>

  <section class="section lp-def-section" id="que-es">
    <div class="container">
      <div class="lp-section-head">
        <div class="section-label">Definición</div>
        <h2 class="section-title">¿Qué hace una agencia SEO en Guadalajara?</h2>
      </div>
      <p class="lp-def">Una agencia SEO en Guadalajara trabaja para que tu negocio aparezca cuando la gente de la Zona Metropolitana busca en Google lo que ofreces, desde el SEO local en Google Maps hasta el contenido y la parte técnica del sitio. Clicroot suma el GEO: optimizamos tu marca para que también aparezca cuando alguien le pregunta a ChatGPT, Perplexity o Gemini por un proveedor tapatío. En una ciudad que concentra tecnología y software, ese comprador con perfil técnico ya consulta a la IA como primer paso, y queremos que te encuentre ahí.</p>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="lp-section-head">
        <div class="section-label">Qué hacemos</div>
        <h2 class="section-title">SEO y GEO para el mercado tapatío.</h2>
      </div>
      <div class="services-grid">
        {services.map((svc) => (
          <div class="service-card">
            <div class="svc-icon">
              <svg fill="none" stroke-linecap="round" stroke-linejoin="round"><use href={svc.icon} /></svg>
            </div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section lp-why-section">
    <div class="container">
      <div class="lp-split">
        <div class="lp-split-head">
          <div class="section-label">Por qué Clicroot</div>
          <h2 class="section-title">La ciudad tech merece SEO con criterio.</h2>
        </div>
        <div class="lp-why-body">
          <p>El ecosistema de software y startups de Guadalajara entiende de tecnología, así que detecta de inmediato a quien improvisa. Clicroot la operan <strong>Felipe Gallo</strong> y <strong>JC Espinosa</strong>, consultores de SEO y visibilidad en IA con experiencia en México, Colombia y Estados Unidos. Trabajas directo con ellos, con un enfoque medible y sin humo.</p>
          <p class="lp-note"><span class="lp-note-kicker">Perfil técnico</span> En una plaza donde tantos compradores son perfiles tech, la visibilidad en IA no es una moda: es donde ya están buscando. Combinamos SEO y GEO para cubrir ambos frentes.</p>
          <a href="/#cases" class="lp-inline-link">Ver casos y resultados →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section lp-faq-section">
    <div class="container">
      <div class="lp-section-head">
        <div class="section-label">Preguntas frecuentes</div>
        <h2 class="section-title">Lo que más nos preguntan en Guadalajara.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section lp-why-section">
    <div class="container">
      <div class="lp-split">
        <div class="lp-split-head">
          <div class="section-label">Cobertura</div>
          <h2 class="section-title">Más allá de Guadalajara.</h2>
        </div>
        <div class="lp-why-body">
          <p>Atendemos a todo el país. Si tu mercado abarca otras plazas, tenemos páginas dedicadas para <a href="/agencia-seo-monterrey" class="lp-inline-link">SEO en Monterrey</a> y la estrategia nacional en <a href="/agencia-seo-mexico" class="lp-inline-link">agencia SEO en México</a>.</p>
          <p>Para ver a fondo cómo combinamos diagnóstico, ejecución y medición, revisa nuestra <a href="/consultoria-seo" class="lp-inline-link">consultoría SEO</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-cta-section">
    <div class="container">
      <div class="lp-cta-inner">
        <h2 class="section-title">¿Hablamos de tu proyecto?</h2>
        <p class="lp-cta-text">Una llamada de 30 minutos para entender tu sitio, tu mercado en Guadalajara y si encajamos. Sin compromiso.</p>
        <a href="/#contact" class="btn-dark">Agenda una llamada</a>
      </div>
    </div>
  </section>

  <Footer t={tf} anchorBase="/" />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>
