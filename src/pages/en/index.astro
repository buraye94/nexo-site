---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { t as translate } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en';
const tf = (key: string) => translate(lang, key);

const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const allCases = await getCollection('cases');
const cases = allCases.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const allBlog = await getCollection('blog');
const blogPosts = allBlog
  .filter(post => post.data.lang === 'en' && !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const stats = tf('results.stats') as any[];
const steps = tf('process.steps') as any[];
const telemetryMsgs = tf('metrics.telemetry') as string[];
const blogIcons = ['#i-bar-chart', '#i-globe', '#i-link'];

const serviceCards = [
  { icon: '#i-search', title: 'SEO Consulting', desc: 'Strategy and execution with a senior consultant, not a junior profile.', href: '/en/seo-consulting' },
  { icon: '#i-globe', title: 'GEO: AI visibility', desc: 'Get ChatGPT, Perplexity, Gemini and the AI Overviews to recommend and cite you.', href: '/en/geo-generative-engine-optimization' },
  { icon: '#i-pen', title: 'Content and on-page', desc: 'Pages that answer real search intent and that AI can cite.', href: '/en/seo-services' },
  { icon: '#i-link', title: 'Link building', desc: 'Real authority with quality links, no shortcuts that end in a penalty.', href: '/en/link-building' },
  { icon: '#i-trending', title: 'Local SEO', desc: 'Show up on Google Maps and in local AI answers, where your customers are.', href: '/en/local-seo' },
  { icon: '#i-bar-chart', title: 'Technical SEO', desc: 'The foundation Google and AI crawlers need to understand your site.', href: '/en/technical-seo' },
];

const whyCards = [
  { title: 'You talk to the specialist', desc: 'You work directly with the senior consultant who designs and runs your strategy, not an account executive who forwards emails.' },
  { title: 'SEO and GEO in one strategy', desc: 'We rank you on Google and in the AI engines. Most providers still only do the first.' },
  { title: 'Bilingual, Spanish and English', desc: 'The same strategy for your markets in Colombia, Mexico and the United States, in both languages.' },
  { title: 'Results, not vanity metrics', desc: 'We measure traffic, rankings and attributable revenue. We report what moves the business.' },
  { title: 'Honest expectations', desc: 'No promises of page one in 30 days. We tell you what is achievable and how long it takes.' },
  { title: 'LatAm focus', desc: 'We understand how your customer searches in Bogota, Mexico City or Monterrey. Regional SEO matters.' },
];

const faqs = [
  { q: 'What exactly does Clicroot do?', a: 'We are an SEO and AI visibility (GEO) consultancy. We rank your brand on Google and make AI engines like ChatGPT, Perplexity and Gemini recommend and cite you, in Spanish and English.' },
  { q: 'Do you work with companies outside Colombia and Mexico?', a: 'Yes. Colombia and Mexico are our core markets, and we also work with companies in the United States and the rest of LatAm that need bilingual SEO.' },
  { q: 'What is GEO and why should I care?', a: 'GEO (generative engine optimization) is optimizing your brand so AI assistants cite it when they answer. The buyer who asks ChatGPT for the best option never sees a Google result, so winning that citation means winning the lead.' },
  { q: 'Consultant or agency?', a: 'Both. You get the senior judgment of a consultant with the execution capacity of a team, without the turnover or the vanity reports of a traditional agency.' },
  { q: 'How long until I see results?', a: 'Technical fixes can move rankings in weeks. Building authority and ranking competitive terms takes three to six months or more. We give you honest expectations from the first call.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<Layout
  title="SEO and GEO Consulting in Colombia and Mexico | Clicroot"
  description={tf('hero.description')}
  lang={lang}
  alternateUrl="/"
>
  <Nav lang="en" t={tf} />

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero-left">
      <div class="hero-badge reveal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-star"/></svg>
        {tf('hero.badge')}
      </div>
      <h1 class="hero-title reveal reveal-d1">
        {tf('hero.title1')}
        <span class="serif-line">{tf('hero.title2')}</span>
        {tf('hero.title3')}
      </h1>
      <p class="hero-description reveal reveal-d2">{tf('hero.description')}</p>
      <div class="hero-actions reveal reveal-d3">
        <a href="#contact" class="btn-primary">{tf('hero.cta1')}</a>
        <a href="#services" class="btn-outline">{tf('hero.cta2')}</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-noise"></div>
      <div class="metric-cards">
        <div class="metric-card mc-1">
          <div class="mc-icon" style="background:var(--accent-subtle);">
            <svg stroke="var(--accent)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trending"/></svg>
          </div>
          <div class="mc-value">+312%</div>
          <div class="mc-label">{tf('metrics.traffic')}</div>
          <div class="mc-trend">
            <svg fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-up"/></svg>
            {tf('metrics.trafficTrend')}
          </div>
        </div>
        <div class="metric-card mc-2">
          <div class="mc-icon" style="background:rgba(201,162,74,0.12);">
            <svg stroke="var(--gold)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trophy"/></svg>
          </div>
          <div class="mc-value">#1</div>
          <div class="mc-label">{tf('metrics.rankings')}</div>
          <div class="telemetry-feed">
            <span class="telemetry-dot"></span>
            <span id="telemetryText" data-messages={JSON.stringify(telemetryMsgs)}></span><span class="telemetry-cursor"></span>
          </div>
        </div>
        <div class="metric-card mc-3">
          <div class="mc-icon" style="background:var(--accent-subtle);">
            <svg stroke="var(--accent)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-dollar"/></svg>
          </div>
          <div class="mc-value">12x</div>
          <div class="mc-label">{tf('metrics.roi')}</div>
          <div class="mc-trend">
            <svg fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-up"/></svg>
            {tf('metrics.roiTrend')}
          </div>
        </div>
        <div class="metric-card mc-4">
          <div class="mc-icon" style="background:rgba(201,162,74,0.12);">
            <svg stroke="var(--gold)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-star"/></svg>
          </div>
          <div class="mc-value">98%</div>
          <div class="mc-label">{tf('metrics.retention')}</div>
        </div>
      </div>
    </div>
  </section>


  <!-- SERVICES -->
  <section class="section services-section" id="services">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('services.label')}</div>
        <h2 class="section-title">{tf('services.title')}</h2>
        <p class="section-subtitle">{tf('services.subtitle')}</p>
      </div>
      <div class="services-grid">
        {serviceCards.map((svc, i) => (
          <a href={svc.href} class={`service-card reveal reveal-d${(i % 4) + 1}`}>
            <div class="svc-icon">
              <svg fill="none" stroke-linecap="round" stroke-linejoin="round"><use href={svc.icon}/></svg>
            </div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </a>
        ))}
      </div>
      <a href="/en/seo-services" class="reveal home-allservices">View all SEO and GEO services →</a>
    </div>
  </section>

  <!-- RESULTS -->
  <section class="section results-section" id="results">
    <div class="container">
      <div class="results-inner">
        <div class="reveal">
          <div class="section-label">{tf('results.label')}</div>
          <p class="manifesto-text">
            {tf('results.manifesto1')}
            <span class="manifesto-highlight">{tf('results.manifesto2')}</span>
          </p>
        </div>
        <div class="stats-grid">
          {stats.map((stat: any, i: number) => (
            <div class={`stat-card reveal reveal-d${i + 1}`}>
              <div class="stat-number">
                <span class="counter" data-target={stat.value}>{stat.value}</span>
                <span class="stat-suffix">{stat.suffix}</span>
              </div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section class="section cases-section" id="cases">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('cases.label')}</div>
        <h2 class="section-title">{tf('cases.title')}</h2>
      </div>
      <div class="cases-stack">
        {cases.map((c, i) => (
          <div class={`case-card reveal reveal-d${i + 1}`}>
            <div class="case-header">
              <span class="case-tag">{c.data.tag}</span>
              <h3>{c.data.title_en}</h3>
              <p class="case-desc">{c.data.description_en}</p>
            </div>
            <div class="case-metrics">
              {(c.data.metrics as any[]).map((m: any) => (
                <div class="case-metric">
                  <div class="case-metric-value">{m.value}</div>
                  <div class="case-metric-label">{m.label_en}</div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CLICROOT -->
  <section class="section why-section" id="why">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Why Clicroot</div>
        <h2 class="section-title">A consultancy, not a black box.</h2>
      </div>
      <div class="why-grid">
        {whyCards.map((w, i) => (
          <div class={`why-card reveal reveal-d${(i % 4) + 1}`}>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process-section" id="process">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('process.label')}</div>
        <h2 class="section-title">{tf('process.title')}</h2>
      </div>
      <div class="process-timeline">
        {steps.map((step: any, i: number) => (
          <div class={`process-step reveal reveal-d${i + 1}`}>
            <div class="process-dot"></div>
            <div class="process-number">{step.num}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section testimonials-section" id="testimonials">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('testimonials.label')}</div>
        <h2 class="section-title">{tf('testimonials.title')}</h2>
      </div>
      <div class="testimonials-track reveal">
        {testimonials.map(t => (
          <div class="testimonial-card">
            <div class="testimonial-stars">
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 24 24"><use href="#i-star-fill"/></svg>
              ))}
            </div>
            <p class="testimonial-text">"{t.data.text_en}"</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.data.initials}</div>
              <div>
                <div class="testimonial-name">{t.data.name}</div>
                <div class="testimonial-role">{t.data.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section lp-faq-section" id="faq">
    <div class="container">
      <div class="lp-section-head reveal">
        <div class="section-label">Frequently asked questions</div>
        <h2 class="section-title">What clients ask us most.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section blog-section" id="blog">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('blog.label')}</div>
        <h2 class="section-title">{tf('blog.title')}</h2>
      </div>
      <div class="blog-grid">
        {blogPosts.map((post, i) => (
          <a href={`/en/blog/${post.slug.replace('es/', '').replace('en/', '')}/`} class={`blog-card reveal reveal-d${i + 1}`}>
            <div class="blog-card-img">
              <svg fill="none" stroke-linecap="round" stroke-linejoin="round"><use href={blogIcons[i % 3]}/></svg>
            </div>
            <div class="blog-card-body">
              <div class="blog-date">{post.data.date.toLocaleDateString('en', { month: 'short', year: 'numeric' }).toUpperCase()}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="blog-read-more">{tf('blog.readMore')} <svg fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-right"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section contact-section" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="reveal">
          <div class="section-label">{tf('contact.label')}</div>
          <h2 class="section-title">{tf('contact.title')}</h2>
          <p class="section-subtitle">{tf('contact.subtitle')}</p>
        </div>
        <form class="contact-form reveal" id="contactForm">
          <div class="form-row">
            <input type="text" class="form-input" placeholder={tf('contact.name')} name="name" required />
            <input type="email" class="form-input" placeholder={tf('contact.email')} name="email" required />
          </div>
          <input type="text" class="form-input" placeholder={tf('contact.website')} name="website" />
          <textarea class="form-textarea" placeholder={tf('contact.message')} name="message"></textarea>
          <button type="submit" class="form-submit" id="formSubmit" data-label={tf('contact.submit')}>{tf('contact.submit')}</button>
        </form>
      </div>
    </div>
  </section>

  <Footer t={tf} anchorBase="/en/" lang="en" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Layout>
</content>
</invoke>
