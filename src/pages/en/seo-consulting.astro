---
import LandingPage from '../../layouts/LandingPage.astro';
import Section from '../../components/Section.astro';

const faqs = [
  { q: 'What does an SEO consultant do?', a: 'An SEO consultant analyzes your site, your market, and your competitors to design and run a strategy that grows your organic traffic and revenue. Unlike an agency that assigns junior staff to your account, with a consultancy you work directly with the specialist who makes the decisions.' },
  { q: 'How much does SEO consulting cost?', a: 'It depends on scope. A one-off audit, an ongoing monthly engagement, and a full campaign each carry different pricing. We agree on the scope up front, with no long-term lock-in. Book a call and we will give you a clear range for your case.' },
  { q: 'SEO consultant or SEO agency: which is right for me?', a: 'An agency usually has more hands for large-scale execution; a consultant gives you senior judgment and focus. At Clicroot we combine both: consultants who design the strategy and execute it, with measurable results.' },
  { q: 'Does it include AI optimization (GEO)?', a: 'Yes. Beyond classic SEO for Google, we optimize your brand to be cited in ChatGPT, Perplexity, Gemini, and AI Overviews. This is called GEO (generative engine optimization), and it is part of every engagement.' },
  { q: 'How long until I see results?', a: 'SEO compounds. Technical fixes and quick wins can move rankings in weeks; building authority and ranking for competitive terms takes three to six months or more. We set honest expectations from the first call.' },
];
---

<LandingPage
  id="consultoria"
  lang="en"
  title="SEO Consulting with Senior Consultants | Clicroot"
  description="SEO consulting with senior consultants, not juniors. Google rankings and AI visibility (GEO) for businesses across the US, Colombia, and Mexico. Book a call."
  kicker="SEO Consulting · US, Colombia, Mexico"
  h1="Senior SEO consulting: the person who designs your strategy is the one who runs it."
  h1Accent="runs it"
  lead="You work directly with the specialist who designs and executes your strategy. We position your brand in Google and in AI search engines like ChatGPT, Perplexity, and Gemini, with measurable results tied to revenue."
  crumbLabel="SEO Consulting"
  proofTitle="SEO consulting clients: leads per month"
  service={{
    serviceType: 'SEO Consulting',
    name: 'SEO and GEO Consulting',
    areaServed: ['US', 'CO', 'MX'],
    description: 'SEO consulting with senior consultants for businesses in the US, Colombia, and Mexico. Google rankings and visibility in AI search engines (GEO).',
  }}
  faqs={faqs}
  faqTitle="Questions about SEO consulting."
>
  <Section tone="paper" title="What is SEO consulting?" id="que-es" narrow>
    <div class="prose">
      <p>SEO consulting is a service in which a specialized consultant audits your website, your market, and your competitors, then designs a strategy so your business shows up first when your customers search on Google and, increasingly, when they ask AI assistants. The consultant does not stop at the diagnosis: they prioritize, execute, and measure the impact on traffic and revenue.</p>
    </div>
  </Section>
</LandingPage>
