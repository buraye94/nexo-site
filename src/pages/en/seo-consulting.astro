---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { t as translate } from '../../i18n/utils';

const lang = 'en';
const tf = (key: string) => translate(lang, key);

const services = [
  { icon: '#i-search', title: 'Technical SEO', desc: 'Crawling, indexing, speed, and architecture. The foundation Google and AI crawlers need to understand your site.' },
  { icon: '#i-pen', title: 'Content and on-page', desc: 'Pages that answer real search intent and that AI models can cite cleanly.' },
  { icon: '#i-link', title: 'Authority and link building', desc: 'Quality links and mentions that build real authority, with no shortcuts that end in a penalty.' },
  { icon: '#i-globe', title: 'Local SEO', desc: 'Show up in Google Maps and in local AI answers, right where your customers are looking.' },
  { icon: '#i-trending', title: 'GEO: AI visibility', desc: 'We optimize your brand so ChatGPT, Perplexity, Gemini, and Google AI Overviews recommend and cite you.' },
  { icon: '#i-bar-chart', title: 'Measurement and reporting', desc: 'Traffic, rankings, and attributable revenue. We report what drives the business, not what looks good on a dashboard.' },
];

const faqs = [
  { q: 'What does an SEO consultant do?', a: 'An SEO consultant analyzes your site, your market, and your competitors to design and run a strategy that grows your organic traffic and revenue. Unlike an agency that assigns junior staff to your account, with a consultancy you work directly with the specialist who makes the decisions.' },
  { q: 'How much does SEO consulting cost?', a: 'It depends on scope. A one-off audit, an ongoing monthly engagement, and a full campaign each carry different pricing. We agree on the scope up front, with no long-term lock-in. Book a call and we will give you a clear range for your case.' },
  { q: 'SEO consultant or SEO agency: which is right for me?', a: 'An agency usually has more hands for large-scale execution; a consultant gives you senior judgment and focus. At Clicroot we combine both: consultants who design the strategy and execute it, with measurable results.' },
  { q: 'Does it include AI optimization (GEO)?', a: 'Yes. Beyond classic SEO for Google, we optimize your brand to be cited in ChatGPT, Perplexity, Gemini, and AI Overviews. This is called GEO (generative engine optimization), and it is part of every engagement.' },
  { q: 'How long until I see results?', a: 'SEO compounds. Technical fixes and quick wins can move rankings in weeks; building authority and ranking for competitive terms takes three to six months or more. We set honest expectations from the first call.' },
];

const pageTitle = 'SEO Consulting with Senior Consultants | Clicroot';
const pageDesc = 'SEO consulting with senior consultants, not juniors. Google rankings and AI visibility (GEO) for businesses across the US, Colombia, and Mexico. Book a call.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://clicroot.com/en/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'SEO Consulting', 'item': 'https://clicroot.com/en/seo-consulting/' },
      ],
    },
    {
      '@type': 'Service',
      'serviceType': 'SEO Consulting',
      'name': 'SEO and GEO Consulting',
      'provider': { '@id': 'https://clicroot.com/#org' },
      'areaServed': ['US', 'CO', 'MX'],
      'availableLanguage': ['English', 'Spanish'],
      'description': 'SEO consulting with senior consultants for businesses in the US, Colombia, and Mexico. Google rankings and visibility in AI search engines (GEO).',
    },
    {
      '@type': 'FAQPage',
      'mainEntity': faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDesc} lang={lang} alternateUrl="/consultoria-seo/">
  <Nav lang="en" t={tf} anchorBase="/en/" />

  <header class="lp-hero">
    <div class="container">
      <nav class="lp-breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Home</a>
        <span aria-hidden="true">/</span>
        <span>SEO Consulting</span>
      </nav>
      <div class="lp-eyebrow">SEO Consulting · US, Colombia, Mexico</div>
      <h1 class="lp-title">SEO consulting with senior consultants, not juniors.</h1>
      <p class="lp-lead">You work directly with the specialist who designs and executes your strategy. We position your brand in Google and in AI search engines like ChatGPT, Perplexity, and Gemini, with measurable results tied to revenue, not impressions.</p>
      <div class="lp-actions">
        <a href="/en/#contact" class="btn-primary">Book a call</a>
        <a href="#que-es" class="btn-outline">What it includes</a>
      </div>
    </div>
  </header>

  <section class="section lp-def-section" id="que-es">
    <div class="container">
      <div class="lp-section-head">
        <div class="section-label">Definition</div>
        <h2 class="section-title">What is SEO consulting?</h2>
      </div>
      <p class="lp-def">SEO consulting is a service in which a specialized consultant audits your website, your market, and your competitors, then designs a strategy so your business shows up first when your customers search on Google and, increasingly, when they ask AI assistants. The consultant does not stop at the diagnosis: they prioritize, execute, and measure the impact on traffic and revenue.</p>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="lp-section-head">
        <div class="section-label">What it includes</div>
        <h2 class="section-title">Full-scope consulting, from the technical layer to AI.</h2>
      </div>
      <div class="services-grid">
        {services.map((svc) => (
          <div class="service-card">
            <div class="svc-icon">
              <svg fill="none" stroke-linecap="round" stroke-linejoin="round"><use href={svc.icon} /></svg>
            </div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section lp-why-section">
    <div class="container">
      <div class="lp-split">
        <div class="lp-split-head">
          <div class="section-label">Who does the work</div>
          <h2 class="section-title">Senior consultants with judgment, not a black box.</h2>
        </div>
        <div class="lp-why-body">
          <p>Clicroot is run by senior SEO and AI visibility consultants with experience across the US, Colombia, and Mexico. When you hire the consultancy you work directly with the specialist who makes the decisions, not an account executive who forwards emails.</p>
          <p class="lp-note"><span class="lp-note-kicker">Bilingual</span> We operate in English and Spanish, with the same strategy for English-speaking and Spanish-speaking markets.</p>
          <a href="/en/#cases" class="lp-inline-link">See cases and results →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section lp-faq-section">
    <div class="container">
      <div class="lp-section-head">
        <div class="section-label">Frequently asked questions</div>
        <h2 class="section-title">What buyers ask us most.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-cta-section">
    <div class="container">
      <div class="lp-cta-inner">
        <h2 class="section-title">Want to talk about your project?</h2>
        <p class="lp-cta-text">A 30-minute call to understand your site, your market, and whether we are a fit. No commitment.</p>
        <a href="/en/#contact" class="btn-dark">Book a call</a>
      </div>
    </div>
  </section>

  <Footer t={tf} anchorBase="/en/" lang="en" />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>
