---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t as translate } from '../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'es';
const tf = (key: string) => translate(lang, key);

const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const allCases = await getCollection('cases');
const cases = allCases.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const allBlog = await getCollection('blog');
const blogPosts = allBlog
  .filter(post => post.data.lang === lang && !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const stats = tf('results.stats') as any[];
const steps = tf('process.steps') as any[];
const telemetryMsgs = tf('metrics.telemetry') as string[];
const blogIcons = ['#i-bar-chart', '#i-globe', '#i-link'];

const clientLogos = [
  { src: '/logos/leal.png', alt: 'Leal', h: 30 },
  { src: '/logos/floowi.png', alt: 'Floowi', h: 27 },
  { src: '/logos/takami.png', alt: 'Takami', h: 23 },
  { src: '/logos/rmh.png', alt: 'Riviera Maya Haciendas', h: 36 },
  { src: '/logos/spi.png', alt: 'SPI Americas', h: 28 },
  { src: '/logos/kyva.png', alt: 'Kyva', h: 30 },
  { src: '/logos/spotme.png', alt: 'SpotMe', h: 27 },
  { src: '/logos/envioclick.png', alt: 'Envioclick', h: 25 },
];

const serviceCards = [
  { icon: '#i-search', title: 'Consultoría SEO', desc: 'Estrategia y ejecución con un consultor senior, no un perfil junior.', href: '/consultoria-seo' },
  { icon: '#i-globe', title: 'GEO: visibilidad en IA', desc: 'Que ChatGPT, Perplexity, Gemini y los AI Overviews te recomienden y te citen.', href: '/geo-posicionamiento-en-ia' },
  { icon: '#i-pen', title: 'Contenido y on-page', desc: 'Páginas que responden la intención real de búsqueda y que la IA puede citar.', href: '/servicios-seo' },
  { icon: '#i-link', title: 'Link building', desc: 'Autoridad real con enlaces de calidad, sin atajos que terminen en penalización.', href: '/link-building' },
  { icon: '#i-trending', title: 'SEO local', desc: 'Aparece en Google Maps y en las respuestas locales de IA, donde están tus clientes.', href: '/seo-local' },
  { icon: '#i-bar-chart', title: 'SEO técnico', desc: 'La base que Google y los crawlers de IA necesitan para entender tu sitio.', href: '/seo-tecnico' },
];

const whyCards = [
  { title: 'Consultores con nombre', desc: 'Trabajas directo con Felipe Gallo y JC Espinosa, no con un ejecutivo de cuenta que reenvía correos.' },
  { title: 'SEO y GEO en una estrategia', desc: 'Posicionamos en Google y en los buscadores de IA. La mayoría todavía solo hace lo primero.' },
  { title: 'Bilingüe, español e inglés', desc: 'La misma estrategia para tus mercados en Colombia, México y Estados Unidos, en los dos idiomas.' },
  { title: 'Resultados, no métricas de vanidad', desc: 'Medimos tráfico, posiciones e ingresos atribuibles. Reportamos lo que mueve el negocio.' },
  { title: 'Expectativas honestas', desc: 'Sin promesas de primera página en 30 días. Te decimos qué es alcanzable y en cuánto tiempo.' },
  { title: 'Enfoque LatAm', desc: 'Entendemos cómo busca tu cliente en Bogotá, en CDMX o en Monterrey. El SEO regional importa.' },
];

const faqs = [
  { q: '¿Qué hace exactamente Clicroot?', a: 'Somos una consultoría de SEO y visibilidad en IA (GEO). Posicionamos tu marca en Google y hacemos que los buscadores de IA como ChatGPT, Perplexity y Gemini te recomienden y te citen, en español e inglés.' },
  { q: '¿Trabajan con empresas fuera de Colombia y México?', a: 'Sí. Colombia y México son nuestros mercados principales, y también trabajamos con empresas de Estados Unidos y del resto de LatAm que necesitan SEO bilingüe.' },
  { q: '¿Qué es GEO y por qué me importa?', a: 'GEO (generative engine optimization) es optimizar tu marca para que los asistentes de IA la citen al responder. El comprador que le pregunta a ChatGPT por la mejor opción nunca ve un resultado de Google, así que ganar esa cita es ganar el lead.' },
  { q: '¿Consultor o agencia?', a: 'Las dos cosas. Tienes el criterio senior de un consultor con la capacidad de ejecución de un equipo, sin la rotación ni los reportes de vanidad de una agencia tradicional.' },
  { q: '¿En cuánto tiempo se ven resultados?', a: 'Las correcciones técnicas pueden mover posiciones en semanas. Construir autoridad y rankear términos competidos toma de tres a seis meses o más. Te damos expectativas honestas desde la primera llamada.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
};
---

<Layout
  title="Consultoría SEO y GEO en Colombia y México | Clicroot"
  description={tf('hero.description')}
  lang={lang}
  alternateUrl="/en/"
>
  <Nav lang={lang} t={tf} />

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero-left">
      <div class="hero-badge reveal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-star"/></svg>
        {tf('hero.badge')}
      </div>
      <h1 class="hero-title reveal reveal-d1">
        {tf('hero.title1')}
        <span class="serif-line">{tf('hero.title2')}</span>
        {tf('hero.title3')}
      </h1>
      <p class="hero-description reveal reveal-d2">{tf('hero.description')}</p>
      <div class="hero-actions reveal reveal-d3">
        <a href="#contact" class="btn-primary">{tf('hero.cta1')}</a>
        <a href="#services" class="btn-outline">{tf('hero.cta2')}</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-noise"></div>
      <div class="metric-cards">
        <div class="metric-card mc-1">
          <div class="mc-icon" style="background:var(--accent-subtle);">
            <svg stroke="var(--accent)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trending"/></svg>
          </div>
          <div class="mc-value">+312%</div>
          <div class="mc-label">{tf('metrics.traffic')}</div>
          <div class="mc-trend">
            <svg fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-up"/></svg>
            {tf('metrics.trafficTrend')}
          </div>
        </div>
        <div class="metric-card mc-2">
          <div class="mc-icon" style="background:rgba(201,162,74,0.12);">
            <svg stroke="var(--gold)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trophy"/></svg>
          </div>
          <div class="mc-value">#1</div>
          <div class="mc-label">{tf('metrics.rankings')}</div>
          <div class="telemetry-feed">
            <span class="telemetry-dot"></span>
            <span id="telemetryText" data-messages={JSON.stringify(telemetryMsgs)}></span><span class="telemetry-cursor"></span>
          </div>
        </div>
        <div class="metric-card mc-3">
          <div class="mc-icon" style="background:var(--accent-subtle);">
            <svg stroke="var(--accent)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-dollar"/></svg>
          </div>
          <div class="mc-value">12x</div>
          <div class="mc-label">{tf('metrics.roi')}</div>
          <div class="mc-trend">
            <svg fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-up"/></svg>
            {tf('metrics.roiTrend')}
          </div>
        </div>
        <div class="metric-card mc-4">
          <div class="mc-icon" style="background:rgba(201,162,74,0.12);">
            <svg stroke="var(--gold)" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-star"/></svg>
          </div>
          <div class="mc-value">98%</div>
          <div class="mc-label">{tf('metrics.retention')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- LOGO BAND -->
  <section class="logo-band">
    <div class="container">
      <div class="logo-band-label">Marcas que confían en Clicroot</div>
      <div class="marquee-wrapper">
        <div class="logos-track">
          {[...clientLogos, ...clientLogos].map((l) => (
            <img src={l.src} alt={l.alt} height={l.h} style={`height:${l.h}px`} loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section services-section" id="services">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('services.label')}</div>
        <h2 class="section-title">{tf('services.title')}</h2>
        <p class="section-subtitle">{tf('services.subtitle')}</p>
      </div>
      <div class="services-grid">
        {serviceCards.map((svc, i) => (
          <a href={svc.href} class={`service-card reveal reveal-d${(i % 4) + 1}`}>
            <div class="svc-icon">
              <svg fill="none" stroke-linecap="round" stroke-linejoin="round"><use href={svc.icon}/></svg>
            </div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </a>
        ))}
      </div>
      <a href="/servicios-seo" class="reveal home-allservices">Ver todos los servicios SEO y GEO →</a>
    </div>
  </section>

  <!-- RESULTS -->
  <section class="section results-section" id="results">
    <div class="container">
      <div class="results-inner">
        <div class="reveal">
          <div class="section-label">{tf('results.label')}</div>
          <p class="manifesto-text">
            {tf('results.manifesto1')}
            <span class="manifesto-highlight">{tf('results.manifesto2')}</span>
          </p>
        </div>
        <div class="stats-grid">
          {stats.map((stat: any, i: number) => (
            <div class={`stat-card reveal reveal-d${i + 1}`}>
              <div class="stat-number">
                <span class="counter" data-target={stat.value}>{stat.value}</span>
                <span class="stat-suffix">{stat.suffix}</span>
              </div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section class="section cases-section" id="cases">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('cases.label')}</div>
        <h2 class="section-title">{tf('cases.title')}</h2>
      </div>
      <div class="cases-stack">
        {cases.map((c, i) => (
          <div class={`case-card reveal reveal-d${i + 1}`}>
            <div class="case-header">
              <span class="case-tag">{c.data.tag}</span>
              <h3>{c.data.title_es}</h3>
              <p class="case-desc">{c.data.description_es}</p>
            </div>
            <div class="case-metrics">
              {(c.data.metrics as any[]).map((m: any) => (
                <div class="case-metric">
                  <div class="case-metric-value">{m.value}</div>
                  <div class="case-metric-label">{m.label_es}</div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CLICROOT -->
  <section class="section why-section" id="why">
    <div class="container">
      <div class="reveal">
        <div class="section-label">Por qué Clicroot</div>
        <h2 class="section-title">Una consultoría, no una caja negra.</h2>
      </div>
      <div class="why-grid">
        {whyCards.map((w, i) => (
          <div class={`why-card reveal reveal-d${(i % 4) + 1}`}>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process-section" id="process">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('process.label')}</div>
        <h2 class="section-title">{tf('process.title')}</h2>
      </div>
      <div class="process-timeline">
        {steps.map((step: any, i: number) => (
          <div class={`process-step reveal reveal-d${i + 1}`}>
            <div class="process-dot"></div>
            <div class="process-number">{step.num}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section testimonials-section" id="testimonials">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('testimonials.label')}</div>
        <h2 class="section-title">{tf('testimonials.title')}</h2>
      </div>
      <div class="testimonials-track reveal">
        {testimonials.map(t => (
          <div class="testimonial-card">
            <div class="testimonial-stars">
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 24 24"><use href="#i-star-fill"/></svg>
              ))}
            </div>
            <p class="testimonial-text">"{t.data.text_es}"</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.data.initials}</div>
              <div>
                <div class="testimonial-name">{t.data.name}</div>
                <div class="testimonial-role">{t.data.role_es}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section lp-faq-section" id="faq">
    <div class="container">
      <div class="lp-section-head reveal">
        <div class="section-label">Preguntas frecuentes</div>
        <h2 class="section-title">Lo que más nos preguntan.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section blog-section" id="blog">
    <div class="container">
      <div class="reveal">
        <div class="section-label">{tf('blog.label')}</div>
        <h2 class="section-title">{tf('blog.title')}</h2>
      </div>
      <div class="blog-grid">
        {blogPosts.map((post, i) => (
          <a href={`/${lang}/blog/${post.slug.replace('es/', '').replace('en/', '')}/`} class={`blog-card reveal reveal-d${i + 1}`}>
            <div class="blog-card-img">
              <svg fill="none" stroke-linecap="round" stroke-linejoin="round"><use href={blogIcons[i % 3]}/></svg>
            </div>
            <div class="blog-card-body">
              <div class="blog-date">{post.data.date.toLocaleDateString('es', { month: 'short', year: 'numeric' }).toUpperCase()}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="blog-read-more">{tf('blog.readMore')} <svg fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-arrow-right"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section contact-section" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="reveal">
          <div class="section-label">{tf('contact.label')}</div>
          <h2 class="section-title">{tf('contact.title')}</h2>
          <p class="section-subtitle">{tf('contact.subtitle')}</p>
        </div>
        <form class="contact-form reveal" id="contactForm">
          <div class="form-row">
            <input type="text" class="form-input" placeholder={tf('contact.name')} name="name" required />
            <input type="email" class="form-input" placeholder={tf('contact.email')} name="email" required />
          </div>
          <input type="text" class="form-input" placeholder={tf('contact.website')} name="website" />
          <textarea class="form-textarea" placeholder={tf('contact.message')} name="message"></textarea>
          <button type="submit" class="form-submit" id="formSubmit" data-label={tf('contact.submit')}>{tf('contact.submit')}</button>
        </form>
      </div>
    </div>
  </section>

  <Footer t={tf} anchorBase="/" lang="es" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Layout>
